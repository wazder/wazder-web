---
type Project = {
  name: string;
  description: string;
  href: string;
  tags: string[];
};

const projects: Project[] = [
  {
    name: 'xtask — compliance platform for German PV installers',
    description:
      'Fills the official 23-page VDE-AR-N 4105 grid-connection AcroForm (557 fields across four forms) from project data and exports XRechnung 3.0 UBL invoices with the § 12 UStG VAT split. Live client-side demo; repo private (client work).',
    href: 'https://wazder.github.io/powerbird/',
    tags: ['Live demo', 'TypeScript', 'PDF', 'Compliance'],
  },
  {
    name: 'Quantum — Windows on Apple Silicon',
    description:
      'From-scratch Windows compatibility layer for macOS in Rust: PE/COFF loader, x86-64 decoder, AArch64 JIT emitter, DXBC-to-Metal shader translation. No Wine, no third-party crates. Unfinished, read-the-code project.',
    href: 'https://github.com/wazder/quantum',
    tags: ['Rust', 'JIT', 'Systems'],
  },
  {
    name: 'Cognitive Drone',
    description:
      'Benchmarking VLM reasoning for autonomous drone gate selection — Qwen2.5-VL and LLaVA evaluated on the full 218-entry CognitiveDroneBench, best configuration 94.5% against a 71.6% CLIP-only baseline.',
    href: 'https://github.com/wazder/cognitive-drone',
    tags: ['VLM', 'Computer Vision', 'Benchmark'],
  },
  {
    name: 'NEST',
    description:
      'Neural EEG Sequence Transducer — decoding brain signals into open-vocabulary text via Transformer encoders and BART cross-attention decoding. Research framework; end-to-end benchmark pending.',
    href: 'https://github.com/wazder/NEST',
    tags: ['PyTorch', 'BCI', 'Transformers'],
  },
  {
    name: 'CamelLayer',
    description:
      'Turkish-to-English prompt-compression engine for AI coding tools, iterated across 17 versions against measured tokenizer counts, with hooks for the Claude, Gemini, Codex, and Copilot CLIs. Closed source; API offline pending a rewrite.',
    href: 'https://camellayer.com',
    tags: ['Product', 'NLP', 'CLI'],
  },
  {
    name: 'Turkish Command Understanding in OpenVLA',
    description:
      'IEEE SIU 2026 paper — performance analysis of vision-language-action models on Turkish robot commands, published in IEEE Xplore. First and corresponding author.',
    href: 'https://ieeexplore.ieee.org/document/11636432',
    tags: ['Research', 'VLA', 'Multilingual'],
  },
];
---

<section id="projects" class="py-32 px-6">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-sm uppercase tracking-[0.3em] text-white mb-10">Selected Work</h2>

    <ul class="divide-y divide-white/10 border-y border-white/10">
      {projects.map((p) => (
        <li>
          <a
            href={p.href}
            target="_blank"
            rel="noreferrer"
            class="flex flex-col gap-3 py-7 group"
          >
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <span class="text-xl font-light group-hover:text-white text-white transition-colors">
                {p.name}
              </span>
              <span class="text-xs text-white group-hover:text-white transition-colors">
                {p.href.replace(/^https?:\/\//, '')} <span class="arrow arrow-up-right">↗</span>
              </span>
            </div>
            <p class="text-sm text-white leading-relaxed max-w-2xl">{p.description}</p>
            <div class="flex gap-2 flex-wrap">
              {p.tags.map((t) => (
                <span class="text-[10px] uppercase tracking-wider text-white border border-white/15 px-2 py-0.5 rounded-full">
                  {t}
                </span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8 text-sm text-white">
      More on
      <a
        href="https://github.com/wazder"
        target="_blank"
        rel="noreferrer"
        class="text-white hover:text-white transition-colors underline underline-offset-4 decoration-white/20"
      >
        github.com/wazder
      </a>.
    </div>
  </div>
</section>
