---
type Publication = {
  title: string;
  authors: string;
  venue: string;
  status: string;
  date: string;
  doi: string;
  href: string;
};

const publications: Publication[] = [
  {
    title:
      'Performance Analysis of Vision-Language-Action Models: Evaluating Turkish Command Understanding in OpenVLA',
    authors: 'H. Tatar, U. Gökmen, I. Akkoyun, S. Kahraman',
    venue: 'IEEE SIU 2026 · 34th Signal Processing and Communications Applications Conference, İstanbul',
    status: 'Published',
    date: 'Jul 2026',
    doi: '10.1109/SIU71813.2026.11636432',
    href: 'https://ieeexplore.ieee.org/document/11636432',
  },
];

const certifications = [
  { issuer: 'Google Cloud', name: 'Professional Cloud Architect' },
  {
    issuer: 'Anthropic',
    name: 'Claude Code in Action · Building with the Claude API · Agent Skills · Model Context Protocol',
  },
  {
    issuer: 'Yapay Zeka ve Teknoloji Akademisi',
    name: 'Advanced AI training program (2025 — 2026)',
  },
];
---

<section id="publications" class="py-32 px-6">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-sm uppercase tracking-[0.3em] text-white mb-10">
      Publications &amp; Certifications
    </h2>

    <div class="space-y-10">
      <div>
        <h3 class="text-xs uppercase tracking-[0.2em] text-white mb-4">Publications</h3>
        <ul class="space-y-6">
          {publications.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noreferrer" class="block group">
                <div class="flex items-baseline justify-between gap-4 flex-wrap">
                  <span class="text-sm text-white max-w-2xl leading-relaxed">
                    {p.title} <span class="arrow arrow-up-right text-xs">↗</span>
                  </span>
                  <span class="text-xs text-white whitespace-nowrap">{p.date}</span>
                </div>
                <div class="text-xs text-white mt-1">{p.authors}</div>
                <div class="text-xs text-white mt-1">
                  {p.venue} <span class="text-white">·</span> {p.status}
                </div>
                <div class="text-xs text-white/60 mt-1">DOI {p.doi}</div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-[0.2em] text-white mb-4">Certifications</h3>
        <ul class="space-y-5 sm:space-y-3">
          {certifications.map((c) => (
            <li class="flex flex-col sm:grid sm:grid-cols-[160px_1fr] gap-1 sm:gap-4 sm:items-baseline">
              <span class="text-xs uppercase tracking-wider text-white">{c.issuer}</span>
              <span class="text-sm text-white">{c.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
