---
type Role = {
  title: string;
  type?: string;
  period: string;
  points: string[];
};

type Job = {
  company: string;
  location: string;
  url?: string;
  roles: Role[];
};

const jobs: Job[] = [
  {
    company: 'US fleet-operations company (NDA)',
    location: 'Remote',
    roles: [
      {
        title: 'Contract Software & AI Engineer',
        type: 'Bus fleet operations platform',
        period: 'May 2026 — Sep 2026',
        points: [
          'Designed a two-plane architecture separating high-frequency location telemetry (HTTP API, Lambda, DynamoDB) from consistency-critical CRUD and live subscriptions (AWS AppSync GraphQL), across 5 CDK stacks and 48 resolvers.',
          'Encoded regulatory hours-of-service limits as a unit-tested pure module, including multi-driver crew math where a two-driver crew is legal on combined remaining hours neither driver could cover alone.',
          "Found four classes of silent AppSync resolver failure invisible to TypeScript, lint, and CDK synth by driving the platform's own evaluate-code API, then wired automated validation of all 48 resolvers into CI.",
        ],
      },
    ],
  },
  {
    company: 'Apparel e-commerce brand (NDA)',
    location: 'Istanbul, Türkiye',
    roles: [
      {
        title: 'Contract Software & AI Engineer',
        type: 'AI customer service and ad automation',
        period: 'May 2026 — Sep 2026',
        points: [
          'Built the orchestration layer of an async AI customer-service pipeline (FastAPI, async SQLAlchemy, PostgreSQL) ingesting HMAC-verified webhooks from four messaging channels through a ten-stage turn.',
          'Cut model spend by short-circuiting intent classification with two zero-token heuristics ahead of any model call; roughly 67% of conversations were classified without one.',
          'Restructured the model request into cached and per-turn blocks after finding the previously fused system prompt broke provider-side prompt-cache prefix matching on every call.',
          'Eliminated duplicate customer messages during rolling deploys with a Postgres transaction-scoped advisory lock keyed on conversation id — one of 771 test functions across 43 modules covering 19,094 lines of production Python.',
        ],
      },
    ],
  },
  {
    company: 'GIS Analytics',
    location: 'London, UK (Remote)',
    roles: [
      {
        title: 'Software Engineer',
        type: 'Freelancer network, client projects',
        period: 'Mar 2026 — Present',
        points: [
          'Built web interfaces with interactive 3D rendering for geospatial data visualization, and full-stack features across the product from data layer to client.',
          "Built an industrial electrical distributor's website and migrated its catalog off a legacy Laravel CMS: an ETL parsing 2,798 bilingual records across 266 categories into 1,875 deduplicated products.",
          'Implemented shared canonical and hreflang metadata plus a locale-aware sitemap covering all products across three locales.',
          'Provided ongoing technical support to a ready-to-wear fashion brand, including Meta Ads account analysis and a scoped service proposal.',
        ],
      },
    ],
  },
  {
    company: 'okeep.co / yaptir.io',
    location: 'Istanbul, Türkiye',
    roles: [
      {
