---

<section id="experience" class="py-32 px-6">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-sm uppercase tracking-[0.3em] text-white/40 mb-10">Experience</h2>

    <ol class="space-y-12">
      {jobs.map((job) => (
        <li>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            {job.url ? (
              <a
                href={job.url}
                target="_blank"
                rel="noreferrer"
                class="text-xl font-light hover:text-white text-white/90 transition-colors"
              >
                {job.company}
              </a>
            ) : (
              <span class="text-xl font-light text-white/90">{job.company}</span>
            )}
            <span class="text-xs text-white/40">{job.location}</span>
          </div>

          <div class="mt-4 space-y-5 border-l border-white/10 pl-5">
            {job.roles.map((role) => (
              <div>
                <div class="flex items-baseline justify-between gap-4 flex-wrap">
                  <span class="text-sm text-white/80">
                    {role.title}
                    {role.type && <span class="text-white/40"> · {role.type}</span>}
                  </span>
                  <span class="text-xs text-white/40">{role.period}</span>
                </div>
                <ul class="mt-2 space-y-1 text-sm text-white/55 leading-relaxed">
                  {role.points.map((p) => (
                    <li class="before:content-['—'] before:mr-2 before:text-white/30">{p}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
