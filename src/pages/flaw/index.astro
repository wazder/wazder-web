---
import Layout from '../../layouts/Layout.astro';
import StatsBar from '../../components/flaw/StatsBar.astro';
import FilterBar from '../../components/flaw/FilterBar.astro';
import ProjectRow from '../../components/flaw/ProjectRow.astro';
import CumulativeLine from '../../components/flaw/charts/CumulativeLine.astro';
import ActivityHeatmap from '../../components/flaw/charts/ActivityHeatmap.astro';
import { loadProjects } from '../../lib/flaw/projects';
import { bucketByMonth, statusColor } from '../../lib/flaw/format';
import type { Project } from '../../lib/flaw/types';

const projects = loadProjects();

const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short' });
const xLabels: string[] = [];
const xKeys: string[] = [];
const now = new Date();
for (let i = 11; i >= 0; i--) {
  const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
  xKeys.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);
  xLabels.push(monthFmt.format(d));
}

const series = projects
  .filter((p) => p.status === 'active' || p.payments.length > 0)
  .map((p: Project) => {
    const buckets = bucketByMonth(p, 12);
    let acc = 0;
    return {
      name: p.name,
      stroke: statusColor(p.status),
      points: buckets.map((b, idx) => {
        acc += b.total;
        return { x: xLabels[idx], y: acc };
      }),
    };
  });
---

<Layout title="flaw — projects" description="Internal project tracker for flaw work.">
  <main class="min-h-screen font-mono text-white">
    <div class="max-w-6xl mx-auto px-5 md:px-8 py-10">

      <header class="flex items-baseline justify-between">
        <div class="flex items-baseline gap-3">
          <a href="/" class="text-white/40 hover:text-white text-xs font-thin">wazder</a>
          <span class="text-white/20">/</span>
          <span class="text-white text-xs">flaw</span>
        </div>
        <div class="flex items-baseline gap-4 text-[11px] font-thin text-white/40">
          <a href="/flaw/access" class="hover:text-white hover:underline underline-offset-4">access</a>
          <span class="text-white/20">·</span>
          <a href="/hub" class="hover:text-white hover:underline underline-offset-4">hub</a>
          <span class="text-white/20">·</span>
          <button id="logout" class="hover:text-white hover:underline underline-offset-4">logout</button>
        </div>
      </header>

      <section class="mt-12">
        <h1 class="font-sans font-light tracking-tight text-4xl md:text-5xl">flaw projects</h1>
        <p class="mt-3 text-sm font-thin text-white/50 max-w-xl">
          Tüm flaw projelerinin durumu, ödemeleri, zaman kaydı ve görevleri tek bir yerde.
        </p>
      </section>

      <section class="mt-12">
        <StatsBar projects={projects} />
      </section>

      <section class="mt-12 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-10">
        <div class="lg:col-span-2">
          <div class="flex items-baseline justify-between border-b border-white/10 pb-2">
            <h2 class="text-[10px] font-thin uppercase tracking-[0.2em] text-white/40">cumulative earned · 12 mo</h2>
            <span class="text-[10px] font-thin text-white/30">per project</span>
          </div>
          <div class="mt-4">
            <CumulativeLine series={series} xLabels={xLabels.map((_, i) => xLabels[i])} height={160} />
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[11px] font-thin">
              {series.length === 0 && <span class="text-white/30">no earnings logged yet</span>}
              {series.map((s) => (
                <span class="inline-flex items-center gap-2">
                  <span class="inline-block w-3 h-px" style={`background:${s.stroke}`}></span>
                  <span class="text-white/70 truncate max-w-[180px]">{s.name}</span>
                </span>
              ))}
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-baseline justify-between border-b border-white/10 pb-2">
            <h2 class="text-[10px] font-thin uppercase tracking-[0.2em] text-white/40">activity · 26 wk</h2>
            <span class="text-[10px] font-thin text-white/30">all projects</span>
          </div>
          <div class="mt-4">
            <ActivityHeatmap projects={projects} weeks={26} />
            <div class="mt-3 flex items-center gap-1.5 text-[10px] font-thin text-white/40">
              <span>less</span>
              {[0.04, 0.2, 0.4, 0.6, 0.85].map((a) => (
                <span class="size-2.5 inline-block" style={`background:rgba(255,255,255,${a})`}></span>
              ))}
              <span>more</span>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-14">
        <div class="flex items-baseline justify-between border-b border-white/10 pb-3 mb-5">
          <h2 class="text-[10px] font-thin uppercase tracking-[0.2em] text-white/40">projects · {projects.length}</h2>
        </div>

        <FilterBar />

        <div id="project-grid" class="mt-3 border-b border-white/10">
          {projects.map((p) => <ProjectRow project={p} />)}
        </div>
        <p id="grid-empty" class="text-xs font-thin text-white/40 mt-4" style="display:none">no projects match.</p>
      </section>

      <footer class="mt-16 pt-6 border-t border-white/10 flex items-baseline justify-between text-[10px] font-thin text-white/30">
        <span>data: <span class="text-white/50">src/data/flaw/projects.json</span></span>
        <span>{new Date().toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
      </footer>
    </div>
  </main>

  <script is:inline>
    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.href = '/hub';
    });
  </script>
</Layout>
