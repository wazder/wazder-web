---
import Layout from '../layouts/Layout.astro';
import { SECTIONS, PEOPLE, TOTAL } from '../data/parcae/questions';
---

<Layout title="parcae formu" description="Parcae ekip formu.">
  <div class="fixed top-0 inset-x-0 z-50 bg-black/90 backdrop-blur border-b border-white/10">
    <div class="max-w-2xl mx-auto px-6 h-12 flex items-center gap-3 text-[15px]">
      <button
        id="home-btn"
        type="button"
        class="hidden items-center gap-1.5 text-white/55 hover:text-white transition-colors"
      >
        <span class="arrow arrow-left">&larr;</span> home
      </button>
      <span id="who-label" class="text-white/45 hidden truncate min-w-0"></span>
      <span class="ml-auto text-white/45 tabular-nums shrink-0" id="counter">0 / {TOTAL}</span>
      <span id="save-state" class="text-white/30 text-right shrink-0"></span>
    </div>
    <div class="h-px bg-white/10">
      <div id="progress" class="h-px bg-white" style="width:0"></div>
    </div>
  </div>

  <main class="min-h-screen px-6 pt-24 pb-32 font-sans text-[17px] leading-relaxed text-white">
    <div class="max-w-2xl mx-auto">
      <!-- kim dolduruyor -->
      <section id="gate">
        <h1 class="text-3xl font-black tracking-tight mb-4">Parcae</h1>
        <p class="text-white/70 mb-8">
          {SECTIONS.length} bölüm, {TOTAL} soru, yaklaşık 40 dakika. Yarım
          bırakabilirsiniz. Cevapların tarayıcında saklanıyor, kaldığın yerden
          devam edebilirsiniz. Bilmediğin soruyu boş geç, "bilmiyorum" da bir
          cevap.
        </p>
        <label for="name-input" class="block text-[15px] text-white/50 mb-3">Kimsin</label>
        <form id="name-form" class="flex gap-2 flex-wrap">
          <input
            type="text"
            id="name-input"
            autocomplete="name"
            maxlength="60"
            placeholder="adını yaz"
            class="flex-1 min-w-[12rem] bg-transparent border border-white/20 focus:border-white outline-none px-4 py-3 placeholder:text-white/25"
          />
          <button
            type="submit"
            class="border border-white px-6 py-3 hover:bg-white hover:text-black transition-colors shrink-0"
          >
            Başla
          </button>
        </form>
        <p id="name-error" class="text-[15px] text-white/60 mt-3 hidden"></p>
        <p class="text-[15px] text-white/45 mt-6">
          Daha önce doldurmaya başladıysan aynı adı yaz, kaldığın yerden devam edersin.
        </p>
      </section>

      <!-- form -->
      <form id="form" class="hidden">
        {
          SECTIONS.map((s) => (
            <section class="mb-16" data-section={s.id}>
              <div class="border-t border-white/20 pt-4 mb-8">
                <p class="text-[19px] font-semibold text-white tabular-nums">
                  {s.no}. {s.title}
                </p>
                <p class="text-white/60 mt-2">{s.lead}</p>
              </div>

              {s.qs.map((q, i) => (
                <div class="mb-10 q-block" data-qid={q.id} data-qtype={q.t}>
                  <div class="flex gap-3">
                    <span class="text-white/35 tabular-nums shrink-0 text-[15px] pt-1">
                      {s.no}.{String(i + 1).padStart(2, '0')}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-white/95">{q.q}</p>
                      {q.hint && <p class="text-[15px] text-white/45 mt-1">{q.hint}</p>}

                      {(q.t === 'choice' || q.t === 'multi') && (
                        <div class="mt-3 grid gap-1.5">
                          {q.opts!.map((o, oi) => (
                            <label class="opt flex items-start gap-2.5 border border-white/15 px-3 py-2 cursor-pointer hover:border-white/40 transition-colors">
                              <input
                                type={q.t === 'multi' ? 'checkbox' : 'radio'}
                                name={`q_${q.id}`}
                                id={`q_${q.id}_${oi}`}
                                value={o}
                                class="mt-1.5 shrink-0"
                              />
                              <span class="text-white/80">{o}</span>
                            </label>
                          ))}
                          <div class="opt flex items-start gap-2.5 border border-white/15 px-3 py-2 hover:border-white/40 transition-colors">
                            <input
                              type={q.t === 'multi' ? 'checkbox' : 'radio'}
                              name={`q_${q.id}`}
                              id={`q_${q.id}_other`}
                              data-other="1"
                              class="mt-1.5 shrink-0 cursor-pointer"
                            />
                            <label for={`q_${q.id}_other`} class="text-white/80 shrink-0 cursor-pointer">
                              Diğer:
                            </label>
                            <input
                              type="text"
                              id={`o_${q.id}`}
                              data-other-text="1"
                              placeholder="kendi cevabını yaz"
                              class="flex-1 min-w-0 bg-transparent border-b border-white/20 focus:border-white outline-none px-1 text-[16px] placeholder:text-white/25"
                            />
                          </div>
                        </div>
                      )}

                      {q.t === 'scale' && (
                        <div class="mt-3">
                          <div class="flex gap-1.5">
                            {[1, 2, 3, 4, 5].map((n) => (
                              <label class="opt flex-1 border border-white/15 py-2 text-center cursor-pointer hover:border-white/40 transition-colors">
                                <input
                                  type="radio"
                                  name={`q_${q.id}`}
                                  id={`q_${q.id}_${n}`}
                                  value={String(n)}
                                  class="sr-only"
                                />
                                <span class="tabular-nums text-[17px] text-white/80">{n}</span>
                              </label>
                            ))}
                          </div>
                          <div class="flex justify-between text-[15px] text-white/45 mt-1.5 gap-4">
                            <span>{q.lo}</span>
                            <span class="text-right">{q.hi}</span>
                          </div>
                        </div>
                      )}

                      {q.t === 'text' && (
                        <textarea
                          id={`q_${q.id}`}
                          name={`q_${q.id}`}
                          rows="3"
                          placeholder={q.ph}
                          class="mt-3 w-full bg-transparent border border-white/15 focus:border-white outline-none px-3 py-2 resize-y placeholder:text-white/25"
                        />
                      )}

                      {q.t === 'short' && (
                        <input
                          type="text"
                          id={`q_${q.id}`}
                          name={`q_${q.id}`}
                          placeholder={q.ph}
                          class="mt-3 w-full bg-transparent border border-white/15 focus:border-white outline-none px-3 py-2 placeholder:text-white/25"
                        />
                      )}

                      {q.note !== false && (
                        <div class="note mt-2 hidden">
                          <input
                            type="text"
                            id={`n_${q.id}`}
                            placeholder="neden? (opsiyonel)"
                            class="w-full bg-transparent border-b border-white/15 focus:border-white/60 outline-none py-1 text-[16px] placeholder:text-white/25"
                          />
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </section>
          ))
        }

        <div class="border-t border-white/20 pt-6">
          <p id="left-note" class="text-white/50 mb-4"></p>
          <div class="flex items-center gap-5 flex-wrap">
            <button
              type="submit"
              class="border border-white px-5 py-2.5 hover:bg-white hover:text-black transition-colors"
            >
              Gönder
            </button>
            <button
              id="reset"
              type="button"
              class="text-[15px] text-white/40 hover:text-white transition-colors underline underline-offset-4"
            >
              cevaplarımı sıfırla
            </button>
          </div>
        </div>
      </form>

      <!-- teşekkürler -->
      <section id="done" class="hidden">
        <h1 class="text-3xl font-black tracking-tight mb-4">Gitti.</h1>
        <p class="text-white/70">
          Cevapların kaydedildi. Üçümüz de doldurunca oturup ayrıştığımız yerleri
          konuşacağız.
        </p>
        <button
          id="reopen"
          type="button"
          class="mt-6 text-[15px] text-white/45 hover:text-white hover:underline underline-offset-4"
        >
          cevaplarımı tekrar düzenle
        </button>
      </section>
    </div>
  </main>

  <style>
    .opt {
      accent-color: #3b82f6;
    }
    .opt:has(input:checked) {
      border-color: #3b82f6;
      background: rgba(59, 130, 246, 0.16);
    }
    .opt:has(input:checked) span,
    .opt:has(input:checked) label {
      color: #fff;
    }
  </style>

  <script>
    import { SECTIONS, TOTAL } from '../data/parcae/questions';
    import type { AnswerMap } from '../lib/parcae/types';

    const LS = 'parcae-form-v1';
    const API = '/api/parcae';

    const gate = document.getElementById('gate') as HTMLElement;
    const form = document.getElementById('form') as HTMLFormElement;
    const done = document.getElementById('done') as HTMLElement;
    const counter = document.getElementById('counter') as HTMLElement;
    const progress = document.getElementById('progress') as HTMLElement;
    const saveState = document.getElementById('save-state') as HTMLElement;
    const whoLabel = document.getElementById('who-label') as HTMLElement;
    const leftNote = document.getElementById('left-note') as HTMLElement;
    const homeBtn = document.getElementById('home-btn') as HTMLButtonElement;
    const nameForm = document.getElementById('name-form') as HTMLFormElement;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const nameError = document.getElementById('name-error') as HTMLElement;

    const ALL = SECTIONS.flatMap((s) => s.qs);

    /** Her kişinin cevabı ayrı tutuluyor: home'a basıp başka biri seçilince
     *  öncekinin cevapları silinmesin. Oturum id'si de kişiye bağlı kalıyor,
     *  böylece API'de aynı kaydın üstüne yazılıyor, yeni satır açılmıyor. */
    type Rec = { id: string; name: string; answers: AnswerMap; submitted: boolean };
    type State = { key: string | null; byPerson: Record<string, Rec> };

    let state: State = { key: null, byPerson: {} };

    /** functions/api/parcae.ts içindeki eşinin birebir aynısı olmalı, yoksa
     *  sunucudaki taslak bulunamaz. toLowerCase() Türkçe İ/I'da ortama göre
     *  değiştiği için o iki harfi elle eşliyoruz. */
    function nameKey(raw: string): string {
      return raw
        .trim()
        .replace(/\s+/g, ' ')
        .replace(/\u0130/g, 'i')
        .replace(/I/g, '\u0131')
        .toLowerCase()
        .slice(0, 60);
    }

    function newId(): string {
      const a = new Uint8Array(12);
      crypto.getRandomValues(a);
      return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('');
    }

    function rec(): Rec {
      const k = state.key;
      if (!k) return { id: newId(), name: '', answers: {}, submitted: false };
      let r = state.byPerson[k];
      if (!r) {
        r = { id: newId(), name: k, answers: {}, submitted: false };
        state.byPerson[k] = r;
      }
      return r;
    }

    function load() {
      try {
        const raw = localStorage.getItem(LS);
        if (!raw) return;
        const o = JSON.parse(raw);
        if (!o || typeof o !== 'object') return;
        state.key = o.key ?? o.who ?? null;
        if (o.byPerson && typeof o.byPerson === 'object') {
          state.byPerson = o.byPerson;
        } else if (o.who && o.answers) {
          // eski tek-kişilik kayıt biçimi
          state.byPerson = {
            [o.who]: {
              id: o.id || newId(),
              name: o.who,
              answers: o.answers,
              submitted: !!o.submitted,
            },
          };
        }
        // eski kayıtlarda görünen ad tutulmuyordu; anahtarı ad olarak kullan
        for (const r of Object.values(state.byPerson)) {
          if (r && !r.name) r.name = '';
        }
        for (const [k, r] of Object.entries(state.byPerson)) {
          if (r && !r.name) r.name = k;
        }
      } catch {
        /* private mode */
      }
    }

    function persist() {
      try {
        localStorage.setItem(LS, JSON.stringify(state));
      } catch {
        /* ignore */
      }
    }

    let timer: number | undefined;
    function scheduleSync() {
      persist();
      if (timer) clearTimeout(timer);
      saveState.textContent = '...';
      timer = window.setTimeout(sync, 2000);
    }

    async function sync(): Promise<boolean> {
      if (!state.key) return false;
      const r = rec();
      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            id: r.id,
            who: r.name || state.key,
            answers: r.answers,
            submitted: r.submitted,
          }),
        });
        saveState.textContent = res.ok ? 'kayıtlı' : 'hata';
        return res.ok;
      } catch {
        saveState.textContent = 'çevrimdışı';
        return false;
      }
    }

    function answered(id: string): boolean {
      const a = rec().answers[id];
      if (!a || a.v == null) return false;
      return Array.isArray(a.v) ? a.v.length > 0 : String(a.v).trim() !== '';
    }

    function refreshCount() {
      const n = ALL.filter((q) => answered(q.id)).length;
      counter.textContent = `${n} / ${TOTAL}`;
      const left = TOTAL - n;
      leftNote.textContent = left
        ? `${left} soru boş. Boş bırakabilirsin ama emin olduğun yerleri doldur.`
        : 'Hepsi cevaplandı.';
    }

    function noteBox(block: Element): HTMLElement | null {
      return block.querySelector('.note');
    }

    /** Header'ın altındaki çizgi sayfadaki konumu gösteriyor. */
    function updateScrollBar() {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 8 ? Math.min(100, (window.scrollY / max) * 100) : 0;
      progress.style.width = `${pct}%`;
    }

    /** Tarayıcı verisi silinmiş veya başka cihaza geçilmişse taslağı sunucudan
     *  geri al. Yerelde daha çok cevap varsa dokunma -- taze girdiyi eskiyle ezmeyelim. */
    async function restoreFromServer() {
      if (!state.key) return;
      const r = rec();
      const localCount = Object.keys(r.answers).length;
      try {
        const res = await fetch(`${API}?who=${encodeURIComponent(r.name || state.key)}`);
        if (!res.ok) return;
        const remote = await res.json();
        if (!remote || !remote.answers) return;
        if (Object.keys(remote.answers).length <= localCount) return;
        r.id = remote.id;
        r.answers = remote.answers;
        r.submitted = !!remote.submitted;
        persist();
        if (!form.classList.contains('hidden')) paint();
        else refreshCount();
        saveState.textContent = 'yüklendi';
      } catch {
        /* çevrimdışı: yerel kayıt zaten duruyor */
      }
    }

    function paint() {
      const answers = rec().answers;
      for (const q of ALL) {
        const a = answers[q.id];
        const block = form.querySelector(`[data-qid="${q.id}"]`);
        if (!block) continue;

        // her boyamada sıfırla, yoksa kişi değişince öncekinin işaretleri kalıyor
        block.querySelectorAll<HTMLInputElement>('input[type=checkbox], input[type=radio]').forEach(
          (el) => {
            el.checked = false;
          },
        );
        const field = block.querySelector<HTMLInputElement | HTMLTextAreaElement>(
          'textarea, input[type=text]:not([id^="n_"])',
        );
        if (field) field.value = '';
        const noteInput = block.querySelector('.note input') as HTMLInputElement | null;
        if (noteInput) noteInput.value = '';

        const otherCtrl = block.querySelector('[data-other]') as HTMLInputElement | null;
        const otherField = block.querySelector('[data-other-text]') as HTMLInputElement | null;
        if (otherField) otherField.value = '';

        if (a?.v != null) {
          const known = new Set(q.opts ?? []);
          if (q.t === 'multi') {
            // eski sürümde bu sorular tekli seçimdi: düz metin de gelebiliyor
            const picked = Array.isArray(a.v) ? a.v : [String(a.v)];
            block.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((el) => {
              if (el.dataset.other) return;
              el.checked = picked.includes(el.value);
            });
            const extra = picked.find((v) => !known.has(v));
            if (extra && otherCtrl && otherField) {
              otherCtrl.checked = true;
              otherField.value = extra;
            }
          } else if (q.t === 'choice') {
            const val = String(a.v);
            if (known.has(val)) {
              block.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((el) => {
                el.checked = !el.dataset.other && el.value === val;
              });
            } else if (val && otherCtrl && otherField) {
              otherCtrl.checked = true;
              otherField.value = val;
            }
          } else if (q.t === 'scale') {
            block.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((el) => {
              el.checked = el.value === a.v;
            });
          } else if (field) {
            field.value = String(a.v);
          }
        }
        if (noteInput && a?.n) noteInput.value = a.n;
        noteBox(block)?.classList.toggle('hidden', !answered(q.id));
      }
      refreshCount();
    }

    /** Şıklardan hiçbirine uymayan değer "diğer" demek; ayrı alan tutmuyoruz. */
    function otherText(block: Element): string {
      const el = block.querySelector('[data-other-text]') as HTMLInputElement | null;
      return el ? el.value.trim() : '';
    }

    function collect(block: HTMLElement, t: string) {
      if (t === 'multi') {
        const picked: string[] = [];
        block.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((x) => {
          if (!x.checked) return;
          if (x.dataset.other) {
            const txt = otherText(block);
            if (txt) picked.push(txt);
          } else {
            picked.push(x.value);
          }
        });
        return picked;
      }
      const chosen = block.querySelector<HTMLInputElement>('input[type=radio]:checked');
      if (!chosen) return '';
      return chosen.dataset.other ? otherText(block) : chosen.value;
    }

    function setAnswer(id: string, v?: string | string[], n?: string) {
      const answers = rec().answers;
      const cur = answers[id] ?? {};
      if (v !== undefined) cur.v = v;
      if (n !== undefined) cur.n = n;
      answers[id] = cur;

      const block = form.querySelector(`[data-qid="${id}"]`);
      if (block) noteBox(block)?.classList.toggle('hidden', !answered(id));
      refreshCount();
      scheduleSync();
    }

    function showGate() {
      form.classList.add('hidden');
      done.classList.add('hidden');
      gate.classList.remove('hidden');
      whoLabel.classList.add('hidden');
      homeBtn.classList.add('hidden');
      homeBtn.classList.remove('flex');
      saveState.textContent = '';
      nameInput.value = rec().name;
      nameError.classList.add('hidden');
      window.scrollTo({ top: 0 });
    }

    function showForm() {
      gate.classList.add('hidden');
      done.classList.add('hidden');
      form.classList.remove('hidden');
      whoLabel.textContent = rec().name;
      whoLabel.classList.remove('hidden');
      homeBtn.classList.remove('hidden');
      homeBtn.classList.add('flex');
      paint();
    }

    function showDone() {
      gate.classList.add('hidden');
      form.classList.add('hidden');
      done.classList.remove('hidden');
      whoLabel.classList.add('hidden');
      homeBtn.classList.remove('hidden');
      homeBtn.classList.add('flex');
    }

    // kimlik
    nameForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const typed = nameInput.value.trim().replace(/\s+/g, ' ');
      const key = nameKey(typed);
      if (!key) {
        nameError.textContent = 'Devam etmek için adını yaz.';
        nameError.classList.remove('hidden');
        nameInput.focus();
        return;
      }
      nameError.classList.add('hidden');
      state.key = key;
      const r = rec();
      r.name = typed;
      persist();
      if (r.submitted) showDone();
      else showForm();
      window.scrollTo({ top: 0 });
      restoreFromServer();
    });

    homeBtn.addEventListener('click', showGate);

    // cevaplar
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      const block = el.closest('[data-qid]') as HTMLElement | null;
      if (!block) return;
      const id = block.dataset.qid!;
      const t = block.dataset.qtype!;
      if (el.id.startsWith('n_')) return;

      if (t === 'multi' || t === 'choice') {
        setAnswer(id, collect(block, t));
        if (el.dataset.other && el.checked) {
          (block.querySelector('[data-other-text]') as HTMLInputElement | null)?.focus();
        }
      } else if (t === 'scale') {
        setAnswer(id, el.value);
      }
    });

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement | HTMLTextAreaElement;
      const block = el.closest('[data-qid]') as HTMLElement | null;
      if (!block) return;
      const id = block.dataset.qid!;
      const t = block.dataset.qtype!;
      if (el.id.startsWith('n_')) {
        setAnswer(id, undefined, el.value);
      } else if (el.dataset.otherText) {
        const ctrl = block.querySelector('[data-other]') as HTMLInputElement | null;
        if (ctrl && !ctrl.checked) ctrl.checked = true;
        setAnswer(id, collect(block, t));
      } else if (el.tagName === 'TEXTAREA' || el.getAttribute('type') === 'text') {
        setAnswer(id, el.value);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      rec().submitted = true;
      persist();
      if (timer) clearTimeout(timer);
      saveState.textContent = '...';
      const ok = await sync();
      if (ok) showDone();
      else {
        rec().submitted = false;
        persist();
        alert('Kaydedilemedi. İnternet bağlantını kontrol edip tekrar dene.');
      }
    });

    document.getElementById('reset')?.addEventListener('click', async () => {
      if (!confirm('Bu formdaki bütün cevapların silinecek. Emin misin?')) return;
      const r = rec();
      r.answers = {};
      r.submitted = false;
      persist();
      paint();
      if (timer) clearTimeout(timer);
      saveState.textContent = '...';
      await sync();
      window.scrollTo({ top: 0 });
    });

    document.getElementById('reopen')?.addEventListener('click', () => {
      rec().submitted = false;
      persist();
      showForm();
    });

    // açılış
    load();
    if (state.key && state.byPerson[state.key]?.submitted) showDone();
    else if (state.key) showForm();
    else {
      nameInput.value = '';
      refreshCount();
    }

    updateScrollBar();
    window.addEventListener('scroll', updateScrollBar, { passive: true });
    window.addEventListener('resize', updateScrollBar);
    if (state.key) restoreFromServer();
  </script>
</Layout>
